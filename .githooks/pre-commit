#!/bin/sh
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT/client"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' | sed 's|^client/||' || true)

if [ -z "$STAGED_FILES" ]; then
	exit 0
fi

echo "$STAGED_FILES" | xargs ./node_modules/.bin/oxfmt --write

echo "$STAGED_FILES" | xargs git add
