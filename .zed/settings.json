{
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-language-server", "oxlint"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "oxfmt",
          "arguments": ["--stdin-filename", "{buffer_path}"]
        }
      }
    },
    "TSX": {
      "language_servers": ["typescript-language-server", "oxlint"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "oxfmt",
          "arguments": ["--stdin-filename", "{buffer_path}"]
        }
      }
    }
  }
}
